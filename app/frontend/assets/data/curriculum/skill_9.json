        "rounds": [
          {
            "raw_text": "`උසයි / ගස / ඒ` -> ඒ ගස උසයි."
          },
          {
            "raw_text": "`පාරේ / බසය / යයි` -> බසය පාරේ යයි."
          },
          {
            "raw_text": "`රසයි / ජම්බු / ඒ` -> ඒ ජම්බු රසයි."
          },
          {
            "raw_text": "`කියවයි / පොත / ළමයා` -> ළමයා පොත කියවයි."
          },
          {
            "raw_text": "`කයි / ජම්බු / ලේනා` -> ලේනා ජම්බු කයි."
          },
          {
            "raw_text": "`උයයි / කෑම / අම්මා` -> අම්මා කෑම උයයි."
          },
          {
            "raw_text": "`ඉනී / ජලයේ / මාළු` -> මාළු ජලයේ ඉනී."
          },
          {
            "raw_text": "`කරයි / පියාසර / කුරුල්ලා` -> කුරුල්ලා පියාසර කරයි."
